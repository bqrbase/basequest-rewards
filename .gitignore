# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files / secrets (never commit real values)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.key
id_rsa*
credentials*.json
service-account*.json

# Hardhat nested project
/hardhat/node_modules
/hardhat/artifacts
/hardhat/cache
/hardhat/dist
/hardhat/coverage
/hardhat/types
/hardhat/.gas-snapshot
/hardhat/snapshots
/hardhat/coverage.json

# Local / editor / agent noise
.vercel
.cursor/
.turbo/
*.log

# typescript
*.tsbuildinfo
next-env.d.ts
