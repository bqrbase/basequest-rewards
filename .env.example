# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser (deployed_contracts inserts)
SUPABASE_SERVICE_ROLE_KEY=

# OnchainKit / wallet
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
# WalletConnect Cloud Project ID — required in production; set this in Vercel env settings
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# LI.FI Quick Swap (optional — higher rate limits / integrator branding)
# Integrator: alphanumeric + ._- only, max 23 chars
# NEXT_PUBLIC_LIFI_API_KEY=
# NEXT_PUBLIC_LIFI_INTEGRATOR=basequest-rewards

# BaseQuest Builder Badge (ERC721) — deploy via hardhat/scripts/deployBaseQuestBadge.ts
NEXT_PUBLIC_BASEQUEST_BADGE_ADDRESS=

# RewardsDistributor (Merkle BQR claims) — Base Mainnet deploy
# Example: 0x8DB0F6a276242787f8DA48360898cC3B5FC0bCe9
# NEXT_PUBLIC_REWARDS_DISTRIBUTOR=

# BqrShareRewardsPoolProduction — server-only operator authorization after Neynar Verify.
# Operator MUST derive 0x058A6B143B622aEAA876A6529969B2F97541e927 (authorize-only; never treasury).
# Never use BQR_SHARE_POOL_OWNER_PRIVATE_KEY, DEPLOYER_PRIVATE_KEY, or PRIVATE_KEY here.
# Inactive until production pool is deployed and both vars below are set.
# BQR_SHARE_POOL_OPERATOR_PRIVATE_KEY=
# BQR_SHARE_REWARDS_POOL_PRODUCTION=0x8f5c7b6AcA62Ed899A0A8E2B1edA6Aa56D6A4814
# BQR_SHARE_POOL_AUTHORIZE_ENABLED=true
#
# Controlled production claim cutover (server/runtime only). Requires production env above.
# When true, API campaigns expose claimPoolAddress for the production pool; inactive on Vercel until set.
# BQR_SHARE_POOL_CLAIM_PRODUCTION_ENABLED=true
#
# Claim pool address (public). Defaults to TEST-ONLY 0x75b99B36DDc4206A3c3A5d89436606e637003151.
# Overrides server claim routing when set. Switch to production only after explicit approval.
# NEXT_PUBLIC_BQR_SHARE_REWARDS_POOL=

# Optional BQR token override (defaults to Base B20 Asset address in lib/token/bqr.ts)
# NEXT_PUBLIC_BQR_TOKEN=

# Rewards Merkle admin APIs (server-only). Never a chain private key.
# Min 16 chars. Used by /api/rewards/admin/* only.
REWARDS_ADMIN_SECRET=

# Task2Earn off-chain verification test seed (never transfers tokens).
# Leave unset in production. POST /api/tasks/dev/seed-test is never automatic.
# Production runtime ignores these even if set (VERCEL_ENV/NODE_ENV=production).
# T2E_ALLOW_TEST_SEED=true
# T2E_SHOW_TEST_TASKS=true
# T2E_TEST_FOLLOW_USERNAME=

# Optional Base RPC for server-side tx verification, isClaimed, and Genesis holder reads
# BASE_RPC_URL=

# x402 payment quest (Base Mainnet) — receiver + CDP facilitator
X402_PAY_TO=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional override (defaults to Coinbase CDP facilitator)
# FACILITATOR_URL=

# Optional Alchemy Base RPC fallback for Asset Diversity (used if Blockscout fails)
# ALCHEMY_API_KEY=
# NEXT_PUBLIC_ALCHEMY_API_KEY=
# ALCHEMY_BASE_RPC_URL=

# App URL used for deployment docs and Farcaster manifest setup
# Example: https://basequest.online
# Also used as the X OAuth redirect base (callback: /api/auth/x/callback)
NEXT_PUBLIC_APP_URL=

# X (Twitter) OAuth 2.0 — server-only, never expose to the client
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Neynar — server-only (Farcaster follow verification)
NEYNAR_API_KEY=

# OpenSea Drops API — server-only (JesseCat mint build). Never NEXT_PUBLIC_*.
OPENSEA_API_KEY=
