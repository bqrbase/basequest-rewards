# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser (deployed_contracts inserts)
SUPABASE_SERVICE_ROLE_KEY=

# OnchainKit / wallet
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
# WalletConnect Cloud Project ID — required in production; set this in Vercel env settings
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# LI.FI Quick Swap (optional — higher rate limits / integrator branding)
# Integrator: alphanumeric + ._- only, max 23 chars
# NEXT_PUBLIC_LIFI_API_KEY=
# NEXT_PUBLIC_LIFI_INTEGRATOR=basequest-rewards

# BaseQuest Builder Badge (ERC721) — deploy via hardhat/scripts/deployBaseQuestBadge.ts
NEXT_PUBLIC_BASEQUEST_BADGE_ADDRESS=

# RewardsDistributor (Merkle BQR claims) — Base Mainnet deploy
# Example: 0x8DB0F6a276242787f8DA48360898cC3B5FC0bCe9
NEXT_PUBLIC_REWARDS_DISTRIBUTOR=

# Optional BQR token override (defaults to Base B20 Asset address in lib/token/bqr.ts)
# NEXT_PUBLIC_BQR_TOKEN=

# Rewards Merkle admin APIs (server-only). Never a chain private key.
# Min 16 chars. Used by /api/rewards/admin/* only.
REWARDS_ADMIN_SECRET=

# Optional Base RPC for server-side isClaimed / campaignCount reads
# BASE_RPC_URL=

# x402 payment quest (Base Mainnet) — receiver + CDP facilitator
X402_PAY_TO=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional override (defaults to Coinbase CDP facilitator)
# FACILITATOR_URL=

# Optional Alchemy Base RPC fallback for Asset Diversity (used if Blockscout fails)
# ALCHEMY_API_KEY=
# NEXT_PUBLIC_ALCHEMY_API_KEY=
# ALCHEMY_BASE_RPC_URL=

# App URL used for deployment docs and Farcaster manifest setup
# Example: https://basequest.online
# Also used as the X OAuth redirect base (callback: /api/auth/x/callback)
NEXT_PUBLIC_APP_URL=

# X (Twitter) OAuth 2.0 — server-only, never expose to the client
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Neynar — server-only (Farcaster follow verification)
NEYNAR_API_KEY=
